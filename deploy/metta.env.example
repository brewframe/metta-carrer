# Salin ke /etc/metta/metta.env, isi, lalu: chmod 600 /etc/metta/metta.env  (jangan masukkan ke git)
METTA_ENV=production
METTA_SECURE_COOKIE=1
METTA_ALLOWED_HOSTS=metta.namasekolah.sch.id
METTA_REGISTER_CODE=ganti-dengan-kode-rahasia-sekolah
METTA_DB=/var/lib/metta/metta.db
METTA_BACKUP_DIR=/var/lib/metta/backups
